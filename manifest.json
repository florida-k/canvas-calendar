{
  "manifest_version": 3,
  "name": "Canvas Calendar Power Tool",
  "version": "1.0",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://ufl.instructure.com/*"
      ],
      "js": [
        "content.js",
        "mycal-sidebar.js"
      ],
      "css": [
        "mycal-sidebar.css",
        "mycal-editor.css"
      ]
    }
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
